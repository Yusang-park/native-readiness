{
  "name": "native-readiness",
  "version": "0.1.0",
  "description": "Report-only native readiness checker for React web codebases moving to React Native via 'use dom' islands and .native.tsx files.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "native-readiness": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "RULES.md",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').chmodSync('dist/cli.js', 0o755)\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepare": "tsc -p tsconfig.build.json && node -e \"require('node:fs').chmodSync('dist/cli.js', 0o755)\""
  },
  "keywords": [
    "react-native",
    "expo",
    "use dom",
    "migration",
    "lint",
    "ai-agents"
  ],
  "dependencies": {
    "@babel/helper-module-imports": "^8.0.0",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "tailwind-merge": "^3.7.0",
    "typescript": "^5.6.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@testing-library/react": "^16.3.3",
    "@types/babel__core": "^7.20.5",
    "@types/babel__helper-module-imports": "^7.18.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "expo-image": "^57.0.5",
    "jsdom": "^30.1.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-svg": "^15.15.5",
    "react-native-web": "^0.21.4",
    "vitest": "^3.2.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/runtime-root.js",
      "browser": "./dist/runtime-root.js",
      "default": "./dist/index.js"
    },
    "./metro": {
      "types": "./dist/metro.d.ts",
      "default": "./dist/metro.js"
    },
    "./babel": {
      "types": "./dist/vite/babel.d.ts",
      "default": "./dist/vite/babel.js"
    },
    "./package.json": "./package.json",
    "./primitives": {
      "types": "./dist/primitives/index.d.ts",
      "default": "./dist/primitives/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "default": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime.d.ts",
      "default": "./dist/jsx-dev-runtime.js"
    },
    "./fonts": {
      "types": "./dist/fonts/fonts.d.ts",
      "default": "./dist/fonts/fonts.js"
    },
    "./web-globals": {
      "types": "./dist/web-globals/web-globals.d.ts",
      "default": "./dist/web-globals/web-globals.js"
    },
    "./babel-create-element": {
      "types": "./dist/create-element-babel.d.ts",
      "default": "./dist/create-element-babel.js"
    }
  },
  "peerDependencies": {
    "expo-image": "*",
    "nativewind": ">=4",
    "react": ">=19",
    "react-native": ">=0.79",
    "react-native-svg": "*"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "nativewind": {
      "optional": true
    },
    "expo-image": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    }
  }
}
